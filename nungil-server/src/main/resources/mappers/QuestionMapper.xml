<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nungil.domain.question.mapper.QuestionMapper">

    <resultMap id="QuestionResultMap" type="com.nungil.domain.question.vo.QuestionVO">
        <id     property="questionId" column="question_id"/>
        <result property="id"         column="id"/>
        <result property="idx"        column="idx"/>
        <result property="status"     column="status"/>
        <result property="createdAt"  column="created_at"/>
        <result property="successAt"  column="success_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.nungil.domain.question.vo.QuestionVO">
        INSERT INTO QUESTION (id, idx, status)
        VALUES (#{id}, #{idx}, #{status})
    </insert>

    <select id="findByUser" resultMap="QuestionResultMap">
        SELECT * FROM QUESTION
        WHERE id = #{id} AND idx = #{idx}
        ORDER BY created_at DESC
    </select>

    <update id="updateStatus">
        UPDATE QUESTION SET status = #{status} WHERE question_id = #{questionId}
    </update>

</mapper>
